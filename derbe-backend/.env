POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=derbe

# Database
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=password
DATABASE__HOST=127.0.0.1
DATABASE__PORT=5432
DATABASE__DATABASE_NAME=derbe

# Application
APPLICATION__APPLICATION_HOST=127.0.0.1
APPLICATION__APPLICATION_PORT=8001
APPLICATION__CORS_ORIGINS=http://localhost:4200
APPLICATION__APP_ENV=Development

# Authentication
AUTH__JWT_SECRET=dev-secret-change-in-production

# SQLx
# DON'T CHANGE THIS NAME FOR SQLx TO WORK
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1/${POSTGRES_DATABASE}