POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=derbe

# Database (also read by SQLx, DON'T CHANGE THIS NAME FOR SQLx TO WORK)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1/${POSTGRES_DATABASE}

# Application
APP_HOST=127.0.0.1
APP_PORT=8001
APP_ENV=Development
CORS_ORIGINS=http://localhost:4200

# Authentication
JWT_SECRET=dev-secret-change-in-production
