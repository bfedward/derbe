# Local development settings. Copy to `.env` (git ignored) and adjust:
#   cp .env.example .env
# These values match the Docker PostgreSQL container from the README.
# Production does not use this file: docker-compose.prod.yml sets the same variables.

# Used to build DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=derbe

# PostgreSQL connection string. Required. Also read by SQLx (macros and CLI),
# so DON'T CHANGE THIS NAME.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1/${POSTGRES_DATABASE}

# Secret used to sign login tokens. Required. Use a long random value outside local dev
# (for example `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-in-production

# Development or Production. Required. Production makes the session cookie Secure.
APP_ENV=Development

# Address and port the API listens on. Optional, defaults to 127.0.0.1 and 8001.
APP_HOST=127.0.0.1
APP_PORT=8001

# Browser origins allowed by CORS. Required, comma separated.
CORS_ORIGINS=http://localhost:4200
