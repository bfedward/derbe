  "query": "\n            UPDATE leave_requests\n            SET employee_unid = $1,\n                leave_type_id = $2,\n                date_from = $3,\n                date_to = $4,\n                first_day_half = $5,\n                last_day_half = $6,\n                total_duration = $7,\n                date_requested = $8,\n                notes = $9\n            WHERE id = $10\n            RETURNING id, \n                employee_unid, \n                leave_type_id, \n                leave_status AS \"leave_status!: LeaveStatus\", \n                date_from, \n                date_to,\n                first_day_half, \n                last_day_half, \n                total_duration,\n                date_requested,\n                date_finalised,\n                notes\n            ",
