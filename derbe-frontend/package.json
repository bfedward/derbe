{
  "name": "derbe-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "knip": "knip --include files,dependencies,binaries",
    "check:quality": "pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "0.542.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.9.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "knip": "6.34.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  }
}
