# syntax=docker/dockerfile:1
# derbe-frontend: Vite SPA built to static files, served by unprivileged nginx.

FROM node:26-alpine AS builder
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY derbe-frontend/package.json derbe-frontend/package.json
RUN --mount=type=cache,target=/pnpm-store pnpm install --frozen-lockfile --store-dir=/pnpm-store

COPY derbe-frontend derbe-frontend

# Vite inlines VITE_* at build time. "/api" is the same-origin path host nginx proxies to the backend.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm --dir derbe-frontend build

FROM nginxinc/nginx-unprivileged:alpine AS runtime
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/derbe-frontend/dist /usr/share/nginx/html
EXPOSE 8080
