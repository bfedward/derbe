#!/bin/sh
set -eu

# Fast checks only. Clippy, biome, knip and typecheck run in pre-push.
staged=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -q '^derbe-backend/.*\.rs$'; then
  (cd derbe-backend && cargo fmt --all --check) || {
    echo "pre-commit: rustfmt failed. Run: cd derbe-backend && cargo fmt --all" >&2
    exit 1
  }
fi

if printf '%s\n' "$staged" | grep -qE '^derbe-(backend|frontend)/src/'; then
  if command -v typos >/dev/null 2>&1; then
    typos derbe-backend/src derbe-frontend/src
  fi
fi
