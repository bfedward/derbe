# syntax=docker/dockerfile:1
# derbe-backend: axum + sqlx API. Builds with SQLX_OFFLINE=true, so derbe-backend/.sqlx must be current
# (`cd derbe-backend && cargo sqlx prepare -- --all-targets`).

FROM lukemathwalker/cargo-chef:latest-rust-1.99.1-bookworm AS chef
WORKDIR /app

FROM chef AS planner
COPY derbe-backend/ .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY derbe-backend/ .
ENV SQLX_OFFLINE=true
RUN cargo build --release --bin derbe-backend

FROM debian:bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --no-create-home --uid 10001 derbe

COPY --from=builder /app/target/release/derbe-backend /usr/local/bin/derbe-backend

USER derbe
ENV RUST_LOG=info
EXPOSE 8001
CMD ["derbe-backend"]
